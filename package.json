{
  "name": "spicetify-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "repository": "Prog-Jacob/spicetify-apps",
  "author": {
    "name": "Ahmed Abdelaziz",
    "url": "https://github.com/Prog-Jacob"
  },
  "scripts": {
    "build": "tsx scripts/build.mts --bundle-locales && pnpm symlink",
    "dev": "tsx scripts/dev.mts",
    "build:app": "tsx scripts/build.mts --bundle-locales --app",
    "typecheck": "tsc -p scripts/tsconfig.json && tsc -p scripts/app-template/tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "node --import tsx --import ./scripts/test-globals.mts --test \"{apps,packages}/*/src/**/*.test.{ts,tsx}\" \"scripts/*.test.mts\"",
    "format": "prettier --write \"**/*.{ts,tsx,mts,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,json,css,md}\"",
    "precommit": "pnpm format:check && pnpm lint --max-warnings 0 && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "release": "tsx scripts/release.mts",
    "download": "tsx scripts/download.mts",
    "symlink": "tsx scripts/symlink.mts",
    "create-app": "tsx scripts/create-app.mts",
    "setup-fork": "tsx scripts/setup-fork.mts",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "esbuild-plugin-external-global": "^1.0.1",
    "eslint": "~10.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "i18n": {
    "bundleLocales": [
      "ar"
    ]
  }
}
