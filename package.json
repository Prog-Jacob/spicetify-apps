{
  "name": "spicetify-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "repository": "Prog-Jacob/spicetify-apps",
  "author": {
    "name": "Ahmed Abdelaziz",
    "url": "https://github.com/Prog-Jacob"
  },
  "scripts": {
    "build": "tsx scripts/build.mts --bundle-locales && pnpm symlink",
    "dev": "tsx scripts/dev-prelaunch.mts && (pnpm symlink && tsx scripts/build.mts --watch & spicetify watch -a & wait)",
    "build:app": "tsx scripts/build.mts --bundle-locales --app",
    "typecheck": "tsc -p scripts/tsconfig.json && tsc -p scripts/app-template/tsconfig.json --noEmit && pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx --import ./scripts/test-globals.mts --test \"{apps,packages}/*/src/**/*.test.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx,mts,json,css,md}\"",
    "precommit": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "release": "tsx scripts/release.mts",
    "download": "pnpm -r run download",
    "symlink": "pnpm -r run symlink",
    "create-app": "tsx scripts/create-app.mts",
    "setup-fork": "tsx scripts/setup-fork.mts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "esbuild-plugin-external-global": "^1.0.1",
    "eslint": "~10.0.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "i18n": {
    "bundleLocales": [
      "ar"
    ]
  }
}
